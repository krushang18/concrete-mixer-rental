# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=localhost

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local dev: postgresql://<your-mac-username>@localhost:5432/concreteMixerRental
# Production: set via deployment secrets (never commit the real URL)
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/concreteMixerRental"

# ── Authentication ────────────────────────────────────────────────────────────
# Use any long random string locally; production key is set in server secrets
JWT_SECRET=local-dev-secret-change-in-production

# ── CORS / Frontend ───────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave as-is for local dev (email features will warn but won't crash the app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ── Business Config ───────────────────────────────────────────────────────────
COMPANY_EMAIL=your-email@gmail.com
ADMIN_EMAILS=your-email@gmail.com
